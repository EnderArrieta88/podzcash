# Base de datos local (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Origen público (para enlaces de email, RSS y embeds)
SITE_URL="http://localhost:3000"

# Secreto para tokens de recuperación de contraseña.
# Genera uno largo y aleatorio; no lo subas al repositorio.
AUTH_SECRET=""

# Resend: envío de emails transaccionales.
# Ver docs/email.md para configurar el dominio y la API key.
RESEND_API_KEY=""
EMAIL_FROM="PodZcash <hola@podzcash.online>"

# Avisos internos: solicitudes de la lista de espera.
WAITLIST_NOTIFY_EMAIL="invitaciones@podzcash.online"

# Carpeta donde se guardan los audios y portadas.
# Relativa a la raíz del proyecto o absoluta (ej. C:/PodZcash/.media)
MEDIA_ROOT="./.media"

# Indice de busqueda (se reconstruye solo si se borra)
SEARCH_DB_PATH="./.data/search.db"
