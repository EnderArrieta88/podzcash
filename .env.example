# Base de datos local (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Origen público (para enlaces de email, RSS y embeds)
SITE_URL="http://localhost:3000"

# Secreto para tokens de recuperación de contraseña.
# Genera uno largo y aleatorio; no lo subas al repositorio.
AUTH_SECRET=""

# Resend: envío de emails transaccionales.
# Ver docs/email.md para configurar el dominio y la API key.
RESEND_API_KEY=""
EMAIL_FROM="PodZcash <hola@podzcash.online>"
FEED_OWNER_EMAIL="hola@podzcash.online"

# Avisos internos: solicitudes de la lista de espera.
WAITLIST_NOTIFY_EMAIL="invitaciones@podzcash.online"

# Web Push para avisos de la lista de espera en el teléfono.
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@podzcash.online"

# Carpeta donde se guardan los audios y portadas.
# Relativa a la raíz del proyecto o absoluta (ej. C:/PodZcash/.media)
MEDIA_ROOT="./.media"

# Indice de busqueda (se reconstruye solo si se borra)
SEARCH_DB_PATH="./.data/search.db"

# Analitica de descargas (SQLite separado; se crea solo)
ANALYTICS_DB_PATH="./.data/analytics.db"

# Sal para hashear IP y user-agent. Si queda vacia se usa AUTH_SECRET.
ANALYTICS_SALT=""

# Zona horaria de los agregados diarios (IANA, por defecto UTC)
ANALYTICS_TIMEZONE="UTC"

# Patrones extra de bots (fragmentos de regex separados por coma)
ANALYTICS_BOT_PATTERNS=""

# Rate limiting persistente (SQLite separado; se crea solo)
RATE_LIMIT_DB_PATH="./.data/rate-limit.db"

# Sal para hashear las claves del rate limit. Si queda vacía se usa AUTH_SECRET.
RATE_LIMIT_SALT=""

# CSP: "enforce" (por defecto) o "report-only" para observar sin bloquear.
# CSP_MODE="enforce"

# Cuota de descargas offline por dispositivo, en MB.
# Se compila en el bundle: cambiarla requiere rebuild.
NEXT_PUBLIC_OFFLINE_AUDIO_QUOTA_MB="1024"
