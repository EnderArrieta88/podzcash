// PodZcash — esquema de datos
// Local: SQLite. Producción: Postgres (mismo modelo, se cambia el provider).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Cuentas, sesiones e invitaciones
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // "admin" | "creator"
  role         String    @default("creator")
  // "active" | "suspended"
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  channel        Channel?
  sessions       Session[]
  invitesCreated Invite[]  @relation("InvitesCreated")
  inviteUsed     Invite?   @relation("InviteUsed")
  reportsResolved Report[] @relation("ReportsResolved")
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 del token: si la base se filtra, las sesiones no son utilizables.
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String?
  createdById String?
  createdBy   User?     @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Canales y contenido
// ---------------------------------------------------------------------------

model Channel {
  id           String   @id @default(cuid())
  handle       String   @unique
  displayName  String
  bio          String?
  avatarKey    String?
  bannerKey    String?
  // Dirección Zcash del creador (t1/t3/zs/u1...). Se usa para generar el QR.
  zcashAddress String?
  // JSON con enlaces sociales: [{ "label": "...", "url": "..." }]
  links        String?
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes Episode[]
}

model Episode {
  id          String    @id @default(cuid())
  channelId   String
  title       String
  slug        String
  description String?
  // "podcast" | "music"
  kind        String    @default("podcast")
  // Ruta relativa dentro de MEDIA_ROOT (nunca una URL absoluta)
  audioPath   String
  coverKey    String?
  durationSec Int?
  fileSize    Int?
  mimeType    String?
  // "draft" | "published" | "hidden"
  status      String    @default("draft")
  publishedAt DateTime?
  playCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  channel Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tags    EpisodeTag[]

  @@unique([channelId, slug])
  @@index([status, publishedAt])
  @@index([channelId, status])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique

  episodes EpisodeTag[]
}

model EpisodeTag {
  episodeId String
  tagId     String

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([episodeId, tagId])
  @@index([tagId])
}

model Report {
  id            String    @id @default(cuid())
  // "episode" | "channel"
  targetType    String
  targetId      String
  reason        String
  details       String?
  reporterEmail String?
  // "open" | "resolved" | "dismissed"
  status        String    @default("open")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedById  String?
  resolvedBy    User?     @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}
