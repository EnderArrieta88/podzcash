{
  "name": "podzcash",
  "version": "0.2.0",
  "private": true,
  "description": "Plataforma de podcasts y música con donaciones directas en ZEC.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnderArrieta88/podzcash.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:setup": "node e2e/setup.mjs",
    "e2e:server": "npm run e2e:setup && next start -p 3100",
    "e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "verify": "npm run check && npm run build && npm run e2e",
    "perf": "node scripts/perf-report.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.38.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-xml-parser": "^5.12.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
